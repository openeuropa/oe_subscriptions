{
    "name": "openeuropa/oe_subscriptions",
    "description": "OpenEuropa Drupal module to handle subscriptions.",
    "type": "drupal-module",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/core": "^10 || ^11",
        "drupal/flag": "^4.0@beta",
        "drupal/message": "^1.8",
        "drupal/message_subscribe": "^2.0"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "drupal/config_devel": "^1.10",
        "drupal/core-composer-scaffold": "^10 || ^11",
        "drupal/core-dev": "^10 || ^11",
        "drupal/datetime_testing": "^1.0@beta",
        "drupal/decoupled_auth": "^3.1",
        "drupal/extra_field": "^3.0@beta",
        "drupal/message_digest": "^1.4",
        "drupal/symfony_mailer": "^1.5",
        "drupal/token": "^1.15",
        "drush/drush": "^12.4 || ^13",
        "openeuropa/code-review-drupal": "^1.0.0-alpha",
        "openeuropa/task-runner-drupal-project-symlink": "^1.0"
    },
    "scripts": {
        "post-install-cmd": "./vendor/bin/run drupal:site-setup",
        "post-update-cmd": "./vendor/bin/run drupal:site-setup"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "autoload": {
        "psr-4": {
            "Drupal\\oe_subscriptions\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\oe_subscriptions\\": "./tests/src",
            "Drupal\\Tests\\oe_subscriptions_anonymous\\": "./modules/oe_subscriptions_anonymous/tests/src/",
            "Drupal\\Tests\\oe_subscriptions_digest\\": "./modules/oe_subscriptions_digest/tests/src/"
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "installer-paths": {
            "build/core": ["type:drupal-core"],
            "build/profiles/contrib/{$name}": ["type:drupal-profile"],
            "build/modules/contrib/{$name}": ["type:drupal-module"],
            "build/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "patches": {
            "drupal/message_digest": {
                "Installing site from existing config fails when message_digest_ui module is part of the install @see https://www.drupal.org/project/message_digest/issues/3375308": "https://www.drupal.org/files/issues/2024-03-07/message_digest-3375308-installing-site-config-fails.patch",
                "Missing plugins in frequency @see https://www.drupal.org/project/message_digest/issues/3477172": "https://www.drupal.org/files/issues/2024-09-27/3477172-9.patch",
                "Invalidate notifier plugin cache when changing and deleting message digest interval @see https://www.drupal.org/project/message_digest/issues/3510956": "https://www.drupal.org/files/issues/2025-03-04/3510956-5.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./build"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": false,
            "phpro/grumphp": true,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    }
}
